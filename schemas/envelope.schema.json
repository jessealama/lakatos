{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lakatos.test/schemas/envelope.schema.json",
  "title": "Lakatos Envelope",
  "description": "The JSON report of one lakatos run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "startedAt", "cwd", "annotations"],
  "properties": {
    "version": { "type": "string" },
    "startedAt": { "type": "string" },
    "cwd": { "type": "string" },
    "seed": { "type": "integer" },
    "generated": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/definitions/annotation" }
    }
  },
  "definitions": {
    "functionName": {
      "type": "string",
      "description": "Bare function name, or Class#method (instance) / Class.method (static).",
      "pattern": "^[$A-Za-z_][$A-Za-z0-9_]*([#.][$A-Za-z_][$A-Za-z0-9_]*)?$"
    },
    "counterexample": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": ["number", "boolean", "string"] }
    },
    "annotation": {
      "oneOf": [
        {
          "title": "unattempted or unrefuted",
          "description": "reason, when present, is the prover's account of why it stopped (GaveUp) or never started (NotTried).",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "enum": ["GaveUp", "NotTried"] },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "unsupported range",
          "description": "The prover never attempted the property: a range endpoint exceeds the safe integer range, so the bounded domain cannot be represented faithfully. reason names the offending endpoint(s).",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "NotTried" },
            "kind": { "const": "unsupported-range" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "proven",
          "description": "The property is a kernel-checked theorem; no prover internals travel with it.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Theorem" }
          }
        },
        {
          "title": "inappropriate",
          "description": "The code the annotation depends on is outside the mappable subset; reason names the offending construct.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "reason"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Inappropriate" },
            "reason": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "input error",
          "description": "The annotation's input is malformed at extraction (duplicate property name, inaccessible subject); error carries the diagnostic. The function label is best-effort: subjects without a proper name use placeholders such as <anonymous>#m or Box#<computed>.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "type": "string", "minLength": 1 },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "InputError" },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "prover error",
          "description": "The prover failed on this annotation before reaching a verdict on the property itself; error carries the diagnostic.",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Error" },
            "error": { "type": "string", "minLength": 1 }
          }
        },
        {
          "title": "falsified",
          "additionalProperties": false,
          "required": [
            "file",
            "function",
            "property",
            "szs",
            "kind",
            "counterexample"
          ],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "CounterSatisfiable" },
            "kind": { "const": "falsified" },
            "counterexample": { "$ref": "#/definitions/counterexample" }
          }
        },
        {
          "title": "threw",
          "additionalProperties": false,
          "required": [
            "file",
            "function",
            "property",
            "szs",
            "kind",
            "counterexample",
            "error"
          ],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "Error" },
            "kind": { "const": "threw" },
            "counterexample": { "$ref": "#/definitions/counterexample" },
            "error": { "type": "string" }
          }
        },
        {
          "title": "exhausted",
          "additionalProperties": false,
          "required": ["file", "function", "property", "szs", "kind", "error"],
          "properties": {
            "file": { "type": "string" },
            "function": { "$ref": "#/definitions/functionName" },
            "property": { "type": "string", "minLength": 1 },
            "szs": { "const": "GaveUp" },
            "kind": { "const": "exhausted" },
            "error": { "type": "string" }
          }
        }
      ]
    }
  }
}
