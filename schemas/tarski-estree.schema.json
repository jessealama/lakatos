{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lakatos.test/schemas/tarski-estree.schema.json",
  "title": "tarski ESTree",
  "description": "The seam between the TypeScript parser bridge and the Lean evaluator: an ESTree-shaped script, narrowed to the node kinds tarski evaluates. Positions are deliberately absent — every message the evaluator produces names a node kind, never a line — and `additionalProperties` is false everywhere so a producer cannot smuggle one in. A node outside the slice is not an error here: the bridge replaces it in place with an `Unsupported` node carrying its kind, and the Lean decoder is the one place that refuses it, so there is one seam and one message.",
  "$ref": "#/definitions/Program",
  "definitions": {
    "Program": {
      "type": "object",
      "properties": {
        "type": { "const": "Program" },
        "sourceType": { "const": "script" },
        "body": {
          "type": "array",
          "items": { "$ref": "#/definitions/Statement" }
        }
      },
      "required": ["type", "sourceType", "body"],
      "additionalProperties": false
    },

    "Statement": {
      "anyOf": [
        { "$ref": "#/definitions/Directive" },
        { "$ref": "#/definitions/ExpressionStatement" },
        { "$ref": "#/definitions/VariableDeclaration" },
        { "$ref": "#/definitions/FunctionDeclaration" },
        { "$ref": "#/definitions/ReturnStatement" },
        { "$ref": "#/definitions/IfStatement" },
        { "$ref": "#/definitions/WhileStatement" },
        { "$ref": "#/definitions/ForStatement" },
        { "$ref": "#/definitions/SwitchStatement" },
        { "$ref": "#/definitions/EmptyStatement" },
        { "$ref": "#/definitions/BlockStatement" },
        { "$ref": "#/definitions/ThrowStatement" },
        { "$ref": "#/definitions/TryStatement" },
        { "$ref": "#/definitions/LabeledStatement" },
        { "$ref": "#/definitions/BreakStatement" },
        { "$ref": "#/definitions/ContinueStatement" },
        { "$ref": "#/definitions/ClassDeclaration" },
        { "$ref": "#/definitions/Unsupported" }
      ]
    },

    "Directive": {
      "description": "A directive-prologue statement. The Lean decoder requires the script's first statement to be this node with directive \"use strict\", and consumes it: tarski has no sloppy mode.",
      "type": "object",
      "properties": {
        "type": { "const": "ExpressionStatement" },
        "expression": { "$ref": "#/definitions/StringLiteral" },
        "directive": { "type": "string" }
      },
      "required": ["type", "expression", "directive"],
      "additionalProperties": false
    },

    "ExpressionStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "ExpressionStatement" },
        "expression": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "expression"],
      "additionalProperties": false
    },

    "VariableDeclaration": {
      "description": "All three keywords are in the slice. A `var` is function-scoped and hoisted — its binding exists, holding `undefined`, before the declaration is reached — while `let` and `const` are block-scoped and have a temporal dead zone.",
      "type": "object",
      "properties": {
        "type": { "const": "VariableDeclaration" },
        "kind": { "enum": ["var", "let", "const"] },
        "declarations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/VariableDeclarator" }
        }
      },
      "required": ["type", "kind", "declarations"],
      "additionalProperties": false
    },

    "VariableDeclarator": {
      "type": "object",
      "properties": {
        "type": { "const": "VariableDeclarator" },
        "id": { "$ref": "#/definitions/Identifier" },
        "init": {
          "oneOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        }
      },
      "required": ["type", "id", "init"],
      "additionalProperties": false
    },

    "IfStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "IfStatement" },
        "test": { "$ref": "#/definitions/Expression" },
        "consequent": { "$ref": "#/definitions/Statement" },
        "alternate": {
          "oneOf": [{ "$ref": "#/definitions/Statement" }, { "type": "null" }]
        }
      },
      "required": ["type", "test", "consequent", "alternate"],
      "additionalProperties": false
    },

    "WhileStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "WhileStatement" },
        "test": { "$ref": "#/definitions/Expression" },
        "body": { "$ref": "#/definitions/Statement" }
      },
      "required": ["type", "test", "body"],
      "additionalProperties": false
    },

    "ForStatement": {
      "description": "Each of the head's three parts is null when it is absent, so `for (;;)` has three. `init` is a VariableDeclaration for a declaration head and an Expression for an expression one; a head declaring a binding pattern is outside the slice and arrives as `Unsupported` in the head's place, so the loop around it still reaches the Lean decoder. `for`-`in` and `for`-`of` are not this node — the whole statement arrives as `Unsupported`.",
      "type": "object",
      "properties": {
        "type": { "const": "ForStatement" },
        "init": {
          "oneOf": [
            { "$ref": "#/definitions/VariableDeclaration" },
            { "$ref": "#/definitions/Expression" },
            { "type": "null" }
          ]
        },
        "test": {
          "oneOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "update": {
          "oneOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "body": { "$ref": "#/definitions/Statement" }
      },
      "required": ["type", "init", "test", "update", "body"],
      "additionalProperties": false
    },

    "SwitchStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "SwitchStatement" },
        "discriminant": { "$ref": "#/definitions/Expression" },
        "cases": {
          "type": "array",
          "items": { "$ref": "#/definitions/SwitchCase" }
        }
      },
      "required": ["type", "discriminant", "cases"],
      "additionalProperties": false
    },

    "SwitchCase": {
      "description": "`test` is null for the `default` clause, which may sit anywhere among the others. `consequent` is the statements between this label and the next one: a bare list, not a block, and not a scope of its own — the whole case block is one scope.",
      "type": "object",
      "properties": {
        "type": { "const": "SwitchCase" },
        "test": {
          "oneOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "consequent": {
          "type": "array",
          "items": { "$ref": "#/definitions/Statement" }
        }
      },
      "required": ["type", "test", "consequent"],
      "additionalProperties": false
    },

    "EmptyStatement": {
      "description": "The bare `;`. It completes empty, so it leaves the running completion value standing.",
      "type": "object",
      "properties": {
        "type": { "const": "EmptyStatement" }
      },
      "required": ["type"],
      "additionalProperties": false
    },

    "BlockStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "BlockStatement" },
        "body": {
          "type": "array",
          "items": { "$ref": "#/definitions/Statement" }
        }
      },
      "required": ["type", "body"],
      "additionalProperties": false
    },

    "ThrowStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "ThrowStatement" },
        "argument": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "argument"],
      "additionalProperties": false
    },

    "TryStatement": {
      "description": "`try { }` with neither a handler nor a finalizer is a syntax error, so the bridge never emits one; the Lean decoder refuses such a document as malformed rather than unsupported, because no program produced it.",
      "type": "object",
      "properties": {
        "type": { "const": "TryStatement" },
        "block": { "$ref": "#/definitions/BlockStatement" },
        "handler": {
          "oneOf": [{ "$ref": "#/definitions/CatchClause" }, { "type": "null" }]
        },
        "finalizer": {
          "oneOf": [
            { "$ref": "#/definitions/BlockStatement" },
            { "type": "null" }
          ]
        }
      },
      "required": ["type", "block", "handler", "finalizer"],
      "additionalProperties": false
    },

    "CatchClause": {
      "description": "The optional-binding form, `catch { }`, has `param: null`. A destructuring binding is outside the slice and arrives as `Unsupported` with the pattern's kind, so the clause — and the `try` around it — survives and only the binding is refused.",
      "type": "object",
      "properties": {
        "type": { "const": "CatchClause" },
        "param": {
          "oneOf": [
            { "$ref": "#/definitions/Identifier" },
            { "$ref": "#/definitions/Unsupported" },
            { "type": "null" }
          ]
        },
        "body": { "$ref": "#/definitions/BlockStatement" }
      },
      "required": ["type", "param", "body"],
      "additionalProperties": false
    },

    "LabeledStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "LabeledStatement" },
        "label": { "$ref": "#/definitions/Identifier" },
        "body": { "$ref": "#/definitions/Statement" }
      },
      "required": ["type", "label", "body"],
      "additionalProperties": false
    },

    "BreakStatement": {
      "description": "`label` is null for the unlabelled form. A `break` outside any loop, and a label that is not on the stack, are checker errors rather than parse errors in tsc, so they reach the evaluator: early errors are outside this epic, and such a jump escapes as the abrupt completion it is.",
      "type": "object",
      "properties": {
        "type": { "const": "BreakStatement" },
        "label": {
          "oneOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }]
        }
      },
      "required": ["type", "label"],
      "additionalProperties": false
    },

    "ContinueStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "ContinueStatement" },
        "label": {
          "oneOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }]
        }
      },
      "required": ["type", "label"],
      "additionalProperties": false
    },

    "Expression": {
      "anyOf": [
        { "$ref": "#/definitions/NumericLiteral" },
        { "$ref": "#/definitions/BooleanLiteral" },
        { "$ref": "#/definitions/NullLiteral" },
        { "$ref": "#/definitions/StringLiteral" },
        { "$ref": "#/definitions/Identifier" },
        { "$ref": "#/definitions/ThisExpression" },
        { "$ref": "#/definitions/UnaryExpression" },
        { "$ref": "#/definitions/UpdateExpression" },
        { "$ref": "#/definitions/BinaryExpression" },
        { "$ref": "#/definitions/LogicalExpression" },
        { "$ref": "#/definitions/ConditionalExpression" },
        { "$ref": "#/definitions/MemberExpression" },
        { "$ref": "#/definitions/CallExpression" },
        { "$ref": "#/definitions/NewExpression" },
        { "$ref": "#/definitions/ArrayExpression" },
        { "$ref": "#/definitions/ObjectExpression" },
        { "$ref": "#/definitions/FunctionExpression" },
        { "$ref": "#/definitions/ArrowFunctionExpression" },
        { "$ref": "#/definitions/AssignmentExpression" },
        { "$ref": "#/definitions/ClassExpression" },
        { "$ref": "#/definitions/Unsupported" }
      ]
    },

    "NumericLiteral": {
      "type": "object",
      "properties": {
        "type": { "const": "Literal" },
        "value": { "type": "number" },
        "raw": { "type": "string" }
      },
      "required": ["type", "value", "raw"],
      "additionalProperties": false
    },

    "BooleanLiteral": {
      "type": "object",
      "properties": {
        "type": { "const": "Literal" },
        "value": { "type": "boolean" },
        "raw": { "enum": ["true", "false"] }
      },
      "required": ["type", "value", "raw"],
      "additionalProperties": false
    },

    "NullLiteral": {
      "type": "object",
      "properties": {
        "type": { "const": "Literal" },
        "value": { "type": "null" },
        "raw": { "const": "null" }
      },
      "required": ["type", "value", "raw"],
      "additionalProperties": false
    },

    "StringLiteral": {
      "description": "A string literal, both as a directive's expression and as an ordinary value. String operations — concatenation, `length`, comparison — are a later slice; a string here can be bound, stored, compared with `===`, and produced by `typeof`.",
      "type": "object",
      "properties": {
        "type": { "const": "Literal" },
        "value": { "type": "string" },
        "raw": { "type": "string" }
      },
      "required": ["type", "value", "raw"],
      "additionalProperties": false
    },

    "Identifier": {
      "description": "`undefined` arrives as an identifier, which is what it is in ESTree; the Lean decoder reads it as the literal a strict-mode script's non-writable global binding makes it.",
      "type": "object",
      "properties": {
        "type": { "const": "Identifier" },
        "name": { "type": "string" }
      },
      "required": ["type", "name"],
      "additionalProperties": false
    },

    "UnaryExpression": {
      "description": "`-`, `+`, `!`, `typeof`, and `void` are in the slice; `~` and `delete` are admitted here and refused by the Lean decoder. `++` and `--` are not here — ESTree makes them an UpdateExpression, and so does this schema.",
      "type": "object",
      "properties": {
        "type": { "const": "UnaryExpression" },
        "operator": {
          "enum": ["-", "+", "!", "~", "typeof", "void", "delete"]
        },
        "argument": { "$ref": "#/definitions/Expression" },
        "prefix": { "const": true }
      },
      "required": ["type", "operator", "argument", "prefix"],
      "additionalProperties": false
    },

    "UpdateExpression": {
      "description": "`++` and `--`, which ESTree separates from UnaryExpression because the side the operator sits on decides the expression's value: the prefix form answers the new number and the postfix form the old one.",
      "type": "object",
      "properties": {
        "type": { "const": "UpdateExpression" },
        "operator": { "enum": ["++", "--"] },
        "argument": { "$ref": "#/definitions/Expression" },
        "prefix": { "type": "boolean" }
      },
      "required": ["type", "operator", "argument", "prefix"],
      "additionalProperties": false
    },

    "BinaryExpression": {
      "description": "Every ESTree binary operator, not only the slice's: the bridge writes what it saw, and the Lean decoder names the one it will not evaluate. `instanceof` is evaluated; `in` is not. `&&`, `||`, and `??` are not here — ESTree makes them a LogicalExpression, and so does this schema.",
      "type": "object",
      "properties": {
        "type": { "const": "BinaryExpression" },
        "operator": {
          "enum": [
            "==",
            "!=",
            "===",
            "!==",
            "<",
            "<=",
            ">",
            ">=",
            "<<",
            ">>",
            ">>>",
            "+",
            "-",
            "*",
            "/",
            "%",
            "**",
            "|",
            "^",
            "&",
            "in",
            "instanceof"
          ]
        },
        "left": { "$ref": "#/definitions/Expression" },
        "right": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "operator", "left", "right"],
      "additionalProperties": false
    },

    "ConditionalExpression": {
      "type": "object",
      "properties": {
        "type": { "const": "ConditionalExpression" },
        "test": { "$ref": "#/definitions/Expression" },
        "consequent": { "$ref": "#/definitions/Expression" },
        "alternate": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "test", "consequent", "alternate"],
      "additionalProperties": false
    },

    "AssignmentExpression": {
      "description": "The evaluator takes `=` and the five arithmetic compound operators — `+=`, `-=`, `*=`, `/=`, `%=` — to an identifier or a member. The schema admits every assignment operator and every target expression so that `**=`, the shifts, the bitwise and logical forms, and an out-of-slice target reach the Lean decoder and are refused there by name.",
      "type": "object",
      "properties": {
        "type": { "const": "AssignmentExpression" },
        "operator": {
          "enum": [
            "=",
            "+=",
            "-=",
            "*=",
            "/=",
            "%=",
            "**=",
            "<<=",
            ">>=",
            ">>>=",
            "|=",
            "^=",
            "&=",
            "&&=",
            "||=",
            "??="
          ]
        },
        "left": { "$ref": "#/definitions/Expression" },
        "right": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "operator", "left", "right"],
      "additionalProperties": false
    },

    "ThisExpression": {
      "type": "object",
      "properties": {
        "type": { "const": "ThisExpression" }
      },
      "required": ["type"],
      "additionalProperties": false
    },

    "LogicalExpression": {
      "description": "The short-circuiting operators, which ESTree separates from BinaryExpression because they do not evaluate both operands. `??` is admitted here and refused by the Lean decoder.",
      "type": "object",
      "properties": {
        "type": { "const": "LogicalExpression" },
        "operator": { "enum": ["&&", "||", "??"] },
        "left": { "$ref": "#/definitions/Expression" },
        "right": { "$ref": "#/definitions/Expression" }
      },
      "required": ["type", "operator", "left", "right"],
      "additionalProperties": false
    },

    "MemberExpression": {
      "description": "`computed` says which spelling was used: `o.x` has an Identifier property and `computed: false`, `o[e]` has an arbitrary expression and `computed: true`. An optional chain (`o?.x`) is not this node — the whole access arrives as `Unsupported`. The object is `Super` for `super.x`, and the property is a `PrivateIdentifier` for `o.#x` — which is not a property key at all, but a name the class's scope resolves.",
      "type": "object",
      "properties": {
        "type": { "const": "MemberExpression" },
        "object": {
          "anyOf": [
            { "$ref": "#/definitions/Expression" },
            { "$ref": "#/definitions/Super" }
          ]
        },
        "property": {
          "anyOf": [
            { "$ref": "#/definitions/Expression" },
            { "$ref": "#/definitions/PrivateIdentifier" }
          ]
        },
        "computed": { "type": "boolean" }
      },
      "required": ["type", "object", "property", "computed"],
      "additionalProperties": false
    },

    "CallExpression": {
      "description": "A spread argument is outside the slice and arrives as an `Unsupported` element in `arguments`; an optional call (`f?.()`) makes the whole call `Unsupported`. A `Super` callee is `super(...)`, which runs the parent constructor rather than calling a value.",
      "type": "object",
      "properties": {
        "type": { "const": "CallExpression" },
        "callee": {
          "anyOf": [
            { "$ref": "#/definitions/Expression" },
            { "$ref": "#/definitions/Super" }
          ]
        },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/Expression" }
        }
      },
      "required": ["type", "callee", "arguments"],
      "additionalProperties": false
    },

    "NewExpression": {
      "description": "`new F` without an argument list carries an empty `arguments`, as ESTree specifies.",
      "type": "object",
      "properties": {
        "type": { "const": "NewExpression" },
        "callee": { "$ref": "#/definitions/Expression" },
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/definitions/Expression" }
        }
      },
      "required": ["type", "callee", "arguments"],
      "additionalProperties": false
    },

    "ArrayExpression": {
      "description": "A hole is outside the slice and arrives as an `Unsupported` element with kind `OmittedExpression`, a spread as one with kind `SpreadElement`; each stands in place, so the literal survives and only the element is refused.",
      "type": "object",
      "properties": {
        "type": { "const": "ArrayExpression" },
        "elements": {
          "type": "array",
          "items": { "$ref": "#/definitions/Expression" }
        }
      },
      "required": ["type", "elements"],
      "additionalProperties": false
    },

    "ObjectExpression": {
      "type": "object",
      "properties": {
        "type": { "const": "ObjectExpression" },
        "properties": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/definitions/Property" },
              { "$ref": "#/definitions/Unsupported" }
            ]
          }
        }
      },
      "required": ["type", "properties"],
      "additionalProperties": false
    },

    "Property": {
      "description": "A plain `key: value` member. Shorthand, methods, accessors, computed keys, and spread are outside the slice and arrive as `Unsupported` members instead, so this node is always `kind: \"init\"` and never computed. A numeric key is admitted here and refused by the Lean decoder.",
      "type": "object",
      "properties": {
        "type": { "const": "Property" },
        "key": {
          "anyOf": [
            { "$ref": "#/definitions/Identifier" },
            { "$ref": "#/definitions/StringLiteral" },
            { "$ref": "#/definitions/NumericLiteral" }
          ]
        },
        "value": { "$ref": "#/definitions/Expression" },
        "kind": { "const": "init" },
        "computed": { "const": false },
        "shorthand": { "const": false },
        "method": { "const": false }
      },
      "required": [
        "type",
        "key",
        "value",
        "kind",
        "computed",
        "shorthand",
        "method"
      ],
      "additionalProperties": false
    },

    "Params": {
      "description": "A parameter list. Only a plain identifier is in the slice: a default or a rest parameter arrives as `Unsupported` with kind `Parameter`, and a binding pattern with the pattern's own kind, so the function node itself survives and only the parameter is refused.",
      "type": "array",
      "items": {
        "anyOf": [
          { "$ref": "#/definitions/Identifier" },
          { "$ref": "#/definitions/Unsupported" }
        ]
      }
    },

    "FunctionExpression": {
      "description": "`async` and `generator` are admitted here and refused by the Lean decoder: they are real syntax whose semantics are outside this epic, so the refusal names them rather than the node.",
      "type": "object",
      "properties": {
        "type": { "const": "FunctionExpression" },
        "id": {
          "oneOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }]
        },
        "params": { "$ref": "#/definitions/Params" },
        "body": { "$ref": "#/definitions/BlockStatement" },
        "async": { "type": "boolean" },
        "generator": { "type": "boolean" }
      },
      "required": ["type", "id", "params", "body", "async", "generator"],
      "additionalProperties": false
    },

    "ArrowFunctionExpression": {
      "description": "`expression` is true for the concise body form, whose `body` is then an Expression rather than a BlockStatement. An arrow is never a generator.",
      "type": "object",
      "properties": {
        "type": { "const": "ArrowFunctionExpression" },
        "id": { "type": "null" },
        "params": { "$ref": "#/definitions/Params" },
        "body": {
          "anyOf": [
            { "$ref": "#/definitions/BlockStatement" },
            { "$ref": "#/definitions/Expression" }
          ]
        },
        "expression": { "type": "boolean" },
        "async": { "type": "boolean" },
        "generator": { "const": false }
      },
      "required": [
        "type",
        "id",
        "params",
        "body",
        "expression",
        "async",
        "generator"
      ],
      "additionalProperties": false
    },

    "FunctionDeclaration": {
      "type": "object",
      "properties": {
        "type": { "const": "FunctionDeclaration" },
        "id": { "$ref": "#/definitions/Identifier" },
        "params": { "$ref": "#/definitions/Params" },
        "body": { "$ref": "#/definitions/BlockStatement" },
        "async": { "type": "boolean" },
        "generator": { "type": "boolean" }
      },
      "required": ["type", "id", "params", "body", "async", "generator"],
      "additionalProperties": false
    },

    "ReturnStatement": {
      "type": "object",
      "properties": {
        "type": { "const": "ReturnStatement" },
        "argument": {
          "oneOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        }
      },
      "required": ["type", "argument"],
      "additionalProperties": false
    },

    "Super": {
      "description": "`super`. Deliberately not an `Expression`: it may only be a member access's object or a call's callee, which are the two places above that admit it, and a `super` anywhere else does not parse.",
      "type": "object",
      "properties": {
        "type": { "const": "Super" }
      },
      "required": ["type"],
      "additionalProperties": false
    },

    "PrivateIdentifier": {
      "description": "A `#name`, with the `#` stripped as ESTree has it. Not an `Expression` either: a bare private name is legal only as the left operand of `in`, which is outside the slice, so the bridge emits `Unsupported` there and this node appears only as a member access's property.",
      "type": "object",
      "properties": {
        "type": { "const": "PrivateIdentifier" },
        "name": { "type": "string" }
      },
      "required": ["type", "name"],
      "additionalProperties": false
    },

    "ClassMemberKey": {
      "anyOf": [
        { "$ref": "#/definitions/Identifier" },
        { "$ref": "#/definitions/StringLiteral" },
        { "$ref": "#/definitions/NumericLiteral" },
        { "$ref": "#/definitions/PrivateIdentifier" }
      ]
    },

    "MethodDefinition": {
      "description": "A class body's constructor, method, getter, or setter. The Lean decoder refuses a private key — a private method is a non-writable element rather than a property — and a numeric key, and an `async` or generator member; the bridge emits all three so that the refusal names them rather than the class. `computed` is always false, a computed key arriving as `Unsupported` in the member's place. A `static constructor` is an ordinary static method of that name, so it arrives with `kind: \"method\"`.",
      "type": "object",
      "properties": {
        "type": { "const": "MethodDefinition" },
        "key": { "$ref": "#/definitions/ClassMemberKey" },
        "value": { "$ref": "#/definitions/FunctionExpression" },
        "kind": { "enum": ["constructor", "method", "get", "set"] },
        "computed": { "const": false },
        "static": { "type": "boolean" }
      },
      "required": ["type", "key", "value", "kind", "computed", "static"],
      "additionalProperties": false
    },

    "PropertyDefinition": {
      "description": "A class field. `value` is null for a field declared without an initializer, which still defines the property, holding `undefined`. A private key is in the slice here, unlike on a method.",
      "type": "object",
      "properties": {
        "type": { "const": "PropertyDefinition" },
        "key": { "$ref": "#/definitions/ClassMemberKey" },
        "value": {
          "anyOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "computed": { "const": false },
        "static": { "type": "boolean" }
      },
      "required": ["type", "key", "value", "computed", "static"],
      "additionalProperties": false
    },

    "ClassBody": {
      "description": "A class body's members, in source order. A static block, a computed key, an `accessor` field, a decorator, and every TypeScript-only modifier or annotation arrive as `Unsupported` in the member's place, so the class around them still reaches the decoder. A bare `;` between members carries no meaning and is dropped.",
      "type": "object",
      "properties": {
        "type": { "const": "ClassBody" },
        "body": {
          "type": "array",
          "items": {
            "anyOf": [
              { "$ref": "#/definitions/MethodDefinition" },
              { "$ref": "#/definitions/PropertyDefinition" },
              { "$ref": "#/definitions/Unsupported" }
            ]
          }
        }
      },
      "required": ["type", "body"],
      "additionalProperties": false
    },

    "ClassDeclaration": {
      "description": "A class declaration, hoisted like a `let`: the binding exists from the top of its block and is in its dead zone until the declaration runs. An `implements` clause, a type parameter list, and a decorator each refuse the whole class rather than one member, because each says something about the class itself the slice cannot represent.",
      "type": "object",
      "properties": {
        "type": { "const": "ClassDeclaration" },
        "id": { "$ref": "#/definitions/Identifier" },
        "superClass": {
          "anyOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "body": { "$ref": "#/definitions/ClassBody" }
      },
      "required": ["type", "id", "superClass", "body"],
      "additionalProperties": false
    },

    "ClassExpression": {
      "description": "A class expression. Its `id`, when it has one, binds the class immutably inside the class's own body and nowhere else.",
      "type": "object",
      "properties": {
        "type": { "const": "ClassExpression" },
        "id": {
          "anyOf": [{ "$ref": "#/definitions/Identifier" }, { "type": "null" }]
        },
        "superClass": {
          "anyOf": [{ "$ref": "#/definitions/Expression" }, { "type": "null" }]
        },
        "body": { "$ref": "#/definitions/ClassBody" }
      },
      "required": ["type", "id", "superClass", "body"],
      "additionalProperties": false
    },

    "Unsupported": {
      "description": "A node outside the slice, standing where it appeared. `kind` is the tsc SyntaxKind name the bridge saw, and it is what the evaluator names on stderr when it refuses the script.",
      "type": "object",
      "properties": {
        "type": { "const": "Unsupported" },
        "kind": { "type": "string" }
      },
      "required": ["type", "kind"],
      "additionalProperties": false
    }
  }
}
