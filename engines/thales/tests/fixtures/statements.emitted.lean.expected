import ThalesDsl

open Js ThalesDsl

set_option autoImplicit false

-- export function floorAtOne(x: number): number {
--   let y = x;
--   if (x < 1) {
--     y = 1;
--   }
--   return y;
-- }
@[js_norm, grind]
def TsModel.floorAtOne (x : JsNumber) : JsM JsNumber := do
  let mut y : JsNumber := x
  if Float.lt x 1 then
    y := 1
  return y

-- export function grade(score: number): number {
--   const bonus = 2;
--   if (score < 0) {
--     throw new RangeError(`negative score: ${score}`);
--   } else if (score < 10) {
--     return score + bonus;
--   }
--   let rank = 0;
--   if (score < 20) {
--     rank = 1;
--   } else {
--     rank = 2;
--   }
--   return rank * 100;
-- }
@[js_norm, grind]
def TsModel.grade (score : JsNumber) : JsM JsNumber := do
  let bonus : JsNumber := 2
  if Float.lt score 0 then
    throw (JsError.error "RangeError")
  else if Float.lt score 10 then
    return score + bonus
  let mut rank : JsNumber := 0
  if Float.lt score 20 then
    rank := 1
  else
    rank := 2
  return rank * 100

-- export function clampUp(x: number): number {
--   if (x < 1) {
--     x = 1;
--   }
--   return x;
-- }
@[js_norm, grind]
def TsModel.clampUp (x : JsNumber) : JsM JsNumber := do
  let mut x := x
  if Float.lt x 1 then
    x := 1
  return x

-- @ensures{floorsAtOne} forall (x: int ∈ [-5, 20)) { floorAtOne(x) >= 1 }
#thales_prove "engines/thales/tests/fixtures/statements.ts" "floorAtOne" "floorsAtOne" :=
  ballIco (-5) 20 fun x =>
    ((do
          return Float.le 1 (← TsModel.floorAtOne (Float.ofInt x))) :
        JsM Bool) =
      pure true

