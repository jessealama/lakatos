-- generated by thales-emit from engines/thales/tests/fixtures/binders.ts
import ThalesDsl

open Js ThalesDsl

set_option autoImplicit false

-- export function keep(x: number): number {
--   if (x < 1) {
--     return 1;
--   }
--   return x;
-- }
@[js_norm, grind]
def TsModel.keep (x : JsNumber) : JsM JsNumber := do
  if Float.lt x 1 then
    return 1
  return x

-- export function twice(x: number): number {
--   return x + x;
-- }
@[js_norm, grind]
def TsModel.twice (x : JsNumber) : JsM JsNumber := do
  return x + x

-- export function scale(value: number, factor: number): number {
--   return value * factor;
-- }
@[js_norm, grind]
def TsModel.scale (value factor : JsNumber) : JsM JsNumber := do
  return value * factor

-- @ensures{chained} forall (x: int ∈ [0, 10)) { x >= 2 → x >= 1 → keep(x) >= 1 }
#thales_prove "engines/thales/tests/fixtures/binders.ts" "keep" "chained" :=
  ballIco 0 10 fun x =>
    (pure (Float.le 2 (Float.ofInt x)) : JsM Bool) = pure true →
      (pure (Float.le 1 (Float.ofInt x)) : JsM Bool) = pure true →
        ((do
              return Float.le 1 (← TsModel.keep (Float.ofInt x))) :
            JsM Bool) =
          pure true

-- @ensures{guardedWitness} forall (x: int ∈ [0, 10)) { x >= 5 → keep(x) >= 6 }
#thales_prove "engines/thales/tests/fixtures/binders.ts" "keep" "guardedWitness" :=
  ballIco 0 10 fun x =>
    (pure (Float.le 5 (Float.ofInt x)) : JsM Bool) = pure true →
      ((do
            return Float.le 6 (← TsModel.keep (Float.ofInt x))) :
          JsM Bool) =
        pure true

-- @ensures{negativeFloor} forall (x: int ∈ [-3, 3)) { twice(x) >= 0 }
#thales_prove "engines/thales/tests/fixtures/binders.ts" "twice" "negativeFloor" :=
  ballIco (-3) 3 fun x =>
    ((do
          return Float.le 0 (← TsModel.twice (Float.ofInt x))) :
        JsM Bool) =
      pure true

-- @ensures{scaled} forall (x y: number) (sf: number ∈ (0, ∞)) { x <= y → scale(x, sf) <= scale(y, sf) }
#thales_prove "engines/thales/tests/fixtures/binders.ts" "scale" "scaled" :=
  ∀ (x : JsNumber),
    ∀ (y : JsNumber),
      ∀ (sf : JsNumber),
        0 < sf →
          sf < floatInf →
            (pure (Float.le x y) : JsM Bool) = pure true →
              ((do
                    return Float.le (← TsModel.scale x sf) (← TsModel.scale y sf)) :
                  JsM Bool) =
                pure true
