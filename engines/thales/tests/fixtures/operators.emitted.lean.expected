-- export function chain(x: number): number {
--   return bump(neg(x)) + 1;
-- }
@[js_norm, grind]
def TsModel.chain (x : JsNumber) : JsM JsNumber := do
  return (← TsModel.bump (← TsModel.neg x)) + 1

