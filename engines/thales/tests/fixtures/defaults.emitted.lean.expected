-- export function add(x: number, y: number = 0): number {
--   return x + y;
-- }
@[js_norm, grind]
def TsModel.add (x : JsNumber) (y : JsVal) : JsM JsNumber := do
  let y : JsNumber :=
    (←
      if JsVal.strictEq y JsVal.undef then
        ((do
              return 0) :
            JsM _)
      else
        ((do
              return (← JsVal.toNumber y)) :
            JsM _))
  return x + y

